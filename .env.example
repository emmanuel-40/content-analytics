# ============================================
# Content Analytics Backend - Environment Template
# Copy to .env and fill in real values. .env is git-ignored.
# Every value here has a safe default, so the app runs with NO .env at all.
# ============================================

# ---------- Runtime ----------
SPRING_PROFILES_ACTIVE=local

# ============================================
# SUPABASE (free tier) - DATABASE
# ============================================
# Both of these come from Supabase Dashboard > Project Settings > Database.
#
# OPTION A - Direct connection (best performance, lowest latency).
# Uses the whole Supabase connection allowance. Fine for a single instance.
#   postgresql://postgres.PROJECTREF:PASSWORD@db.PROJECTREF.supabase.co:5432/postgres
#
# OPTION B - Transaction pooler (recommended for Render).
# Survives connection churn and sleeps. Port 6543.
# NOTE: the transaction pooler does NOT support prepared statements,
# so the JDBC URL must include prepareThreshold=0.
#   postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?prepareThreshold=0
#
# The default below uses the transaction pooler.
DATABASE_URL=jdbc:postgresql://postgres.PROJECTREF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?prepareThreshold=0&sslmode=require
DB_USERNAME=postgres.PROJECTREF
DB_PASSWORD=your-supabase-db-password
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_REGION=eu-central-1

# ---------- Redis ----------
# Use localhost when running the app on your machine,
# or redis when running inside docker compose.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- JWT ----------
# MUST be >= 64 bytes for HS512. Generate one with:
#   openssl rand -base64 64
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-minimum-64-bytes-long-0123456789

# ============================================
# SUPABASE STORAGE (free: 1 GB storage + 5 GB egress/month)
# ============================================
# Supabase Storage is S3-compatible, so S3StorageService works unchanged.
# The S3 API is an open protocol implemented by Supabase, MinIO, R2 and others,
# so the AWS SDK can be pointed at Supabase's endpoint instead of AWS.
#
# Enable it: Dashboard > Storage > Settings > "S3 protocol" must be ON.
#
# Generate keys: Dashboard > Project Settings > API > S3 Access Keys
#
# Create the bucket first (Dashboard > Storage > New bucket) and leave it
# PRIVATE. Documents are streamed to the client through the authenticated
# download endpoint, and avatars use short-lived signed URLs, so nothing
# needs public read access.
STORAGE_TYPE=s3

AWS_S3_BUCKET_NAME=content-analytics
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=your-s3-access-key-id
AWS_SECRET_ACCESS_KEY=your-s3-secret-access-key

# Supabase's S3-compatible gateway endpoint
AWS_S3_ENDPOINT=https://PROJECTREF.supabase.co/storage/v1/s3
AWS_S3_FORCE_PATH_STYLE=true

# ---------- AI (Google Gemini - free tier) ----------
# Pick the provider with AI_PROVIDER: gemini | anthropic | none
# With no API key the app still runs and falls back to basic analysis.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional alternative backend (Anthropic has no free tier)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ---------- Email (Brevo - 300 emails/day free) ----------
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Content Analytics Platform

# ---------- Frontend / CORS ----------
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# ============================================
# Docker Compose overrides
# When running via docker compose, point these at the service names.
# ============================================
# DATABASE_URL=jdbc:postgresql://postgres:5432/content_analytics_db
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# REDIS_HOST=redis